# The initial code is empty, so let's add a basic Azure CLI command as an example
# This command lists all the resource groups in the current subscription

# List all resource groups in the current subscription
#az group list --output table
# Delete the resource group
#az group delete --resource-group cmaz-efe625c7-mod1-rg

# ------ TASK 2 NETWORKING 1 ------
#Add the resource group
az group create --name cmaz-efe625c7-mod1-rg-01 --location eastus

# Create  virtual network cmaz-efe625c7-mod2-vnet-01
az network vnet create -g cmaz-efe625c7-mod1-rg-01 -n cmaz-efe625c7-mod2-vnet-01 -l \
    eastus  --address-prefix 10.2.0.0/16 --subnet-name frontend-01 --subnet-prefix 10.2.0.0/24

# Create the gateway subnet for the virtual network cmaz-efe625c7-mod2-vnet-01
az network vnet subnet create --vnet-name  cmaz-efe625c7-mod2-vnet-01 -n GatewaySubnet -g cmaz-efe625c7-mod1-rg-01  --address-prefix 10.2.255.0/27

# Create VPN gateway public IP address
az network public-ip create -g cmaz-efe625c7-mod1-rg-01 -n cmaz-efe625c7-mod2-pip-01 --sku Standard --allocation-method Static --l eastus

az network vnet-gateway create --name cmaz-efe625c7-mod2-vpng-01 --public-ip-address cmaz-efe625c7-mod2-pip-01  
    --resource-group cmaz-efe625c7-mod1-rg-01 
    --vnet cmaz-efe625c7-mod2-vnet-01 
    --gateway-type Vpn 
    --sku VpnGw2 
    --vpn-gateway-generation Generation2 --no-wait

# ------ TASK 2 NETWORKING 2 ------
az group create --name cmaz-efe625c7-mod1-rg-02 --location eastus

# Create  virtual network cmaz-efe625c7-mod2-vnet-02
az network vnet create -g cmaz-efe625c7-mod1-rg-02 -n cmaz-efe625c7-mod2-vnet-02 -l eastus 
    --address-prefix 10.24.0.0/16 --subnet-name frontend-02 --subnet-prefix 10.24.0.0/24

# Create the gateway subnet for the virtual network cmaz-efe625c7-mod2-vnet-02
az network vnet subnet create 
    --vnet-name  cmaz-efe625c7-mod2-vnet-02 -n GatewaySubnet -g cmaz-efe625c7-mod1-rg-02 
    --address-prefix 10.24.255.0/27

az network public-ip create -g cmaz-efe625c7-mod1-rg-02 -n cmaz-efe625c7-mod2-pip-02 
    --sku Standard --allocation-method Static --l eastus

az network vnet-gateway create --name cmaz-efe625c7-mod2-vpng-02 
    --public-ip-address cmaz-efe625c7-mod2-pip-02  
    --resource-group cmaz-efe625c7-mod1-rg-02 
    --vnet cmaz-efe625c7-mod2-vnet-02 
    --gateway-type Vpn 
    --sku VpnGw2 
    --vpn-gateway-generation Generation2 --no-wait

    